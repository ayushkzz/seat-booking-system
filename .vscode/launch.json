{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "booking-service",
      "request": "launch",
      "mainClass": "io.github.ayushkzz.seatbooking.booking.BookingServiceApplication",
      "projectName": "booking-service"
    },
    {
      "type": "java",
      "name": "payment-service",
      "request": "launch",
      "mainClass": "io.github.ayushkzz.seatbooking.payment.PaymentServiceApplication",
      "projectName": "payment-service",
      "env": {
        "PAYMENT_FAILURE_RATE": "0"
      }
    },
    {
      "type": "java",
      "name": "notification-service",
      "request": "launch",
      "mainClass": "io.github.ayushkzz.seatbooking.notification.NotificationServiceApplication",
      "projectName": "notification-service"
    },
    {
      "type": "java",
      "name": "gateway",
      "request": "launch",
      "mainClass": "io.github.ayushkzz.seatbooking.gateway.GatewayApplication",
      "projectName": "gateway"
    }
  ],
  "compounds": [
    {
      "name": "All services",
      "configurations": [
        "booking-service",
        "payment-service",
        "notification-service",
        "gateway"
      ]
    }
  ]
}
